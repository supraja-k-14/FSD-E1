provider "aws" {
  region = "us-east-1"
}

# -------------------------------
# Compute Service (EC2 Instance)
# -------------------------------
resource "aws_instance" "app_server" {
  ami           = "ami-0c55b159cbfafe1f0"   # Amazon Linux (example)
  instance_type = "t2.micro"

  tags = {
    Name = "TaskAppServer"
  }
}

# -------------------------------
# Storage Service (S3 Bucket)
# -------------------------------
resource "aws_s3_bucket" "app_bucket" {
  bucket = "my-task-app-bucket-12345"

  tags = {
    Name        = "TaskAppBucket"
    Environment = "Dev"
  }
}

# -------------------------------
# Networking (Security Group)
# -------------------------------
resource "aws_security_group" "app_sg" {
  name        = "app-security-group"
  description = "Allow HTTP and SSH"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
