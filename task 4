<?php
$conn=new mysqli("localhost","root","","student_system");
$orderHistory=$conn->query("SELECT customers.name,products.product_name,orders.quantity,products.price,(orders.quantity*products.price) as total,orders.order_date FROM orders JOIN customers ON orders.customer_id=customers.id JOIN products ON orders.product_id=products.id ORDER BY orders.order_date DESC");
$highestOrder=$conn->query("SELECT customers.name,(orders.quantity*products.price) as total FROM orders JOIN customers ON orders.customer_id=customers.id JOIN products ON orders.product_id=products.id WHERE (orders.quantity*products.price)=(SELECT MAX(o.quantity*p.price) FROM orders o JOIN products p ON o.product_id=p.id)");
$activeCustomer=$conn->query("SELECT name FROM customers WHERE id=(SELECT customer_id FROM orders GROUP BY customer_id ORDER BY COUNT(*) DESC LIMIT 1)");
?>
