CREATE TABLE accounts(id INT AUTO_INCREMENT PRIMARY KEY,name VARCHAR(100),balance DECIMAL(10,2));
INSERT INTO accounts(name,balance)VALUES('User',5000),('Merchant',1000);
<?php
$conn=new mysqli("localhost","root","","student_system");
$user_id=1;
$merchant_id=2;
$amount=500;
$conn->autocommit(FALSE);
try{
$user=$conn->query("SELECT balance FROM accounts WHERE id=$user_id")->fetch_assoc();
if($user['balance']<$amount){throw new Exception("Insufficient Balance");}
$conn->query("UPDATE accounts SET balance=balance-$amount WHERE id=$user_id");
$conn->query("UPDATE accounts SET balance=balance+$amount WHERE id=$merchant_id");
$conn->commit();
echo "Payment Successful";
}
catch(Exception $e){
$conn->rollback();
echo "Payment Failed: ".$e->getMessage();
}
$conn->autocommit(TRUE);
?>
