const express = require("express");
const sqlite3 = require("sqlite3").verbose();
const bodyParser = require("body-parser");
const app = express();
app.use(bodyParser.json());
app.use(bodyParser.urlencoded({ extended: true }));
const db = new sqlite3.Database("trackwise.db");
db.serialize(() => {
  db.run(
    "CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT, password TEXT)"
  );
  db.run(
    "CREATE TABLE IF NOT EXISTS expenses(id INTEGER PRIMARY KEY AUTOINCREMENT, category TEXT, amount INTEGER, date TEXT)"
  );
});
app.get("/", (req, res) => {
  res.send(`
<!DOCTYPE html>
<html>
<head>
<title>TrackWise</title>
<style>
body{font-family:Arial;background:#eef2f7;margin:0}
header{background:#2c3e50;color:white;padding:15px;text-align:center}
.container{padding:20px}
input,select{padding:8px;margin:5px;width:200px}
button{padding:10px;background:#3498db;color:white;border:none}
table{border-collapse:collapse;width:60%;margin-top:20px}
td,th{border:1px solid #ddd;padding:8px;text-align:center}
</style>
</head>
<body>
<header>
<h1>TrackWise: Relational Expense Analytics Platform</h1>
</header>
<div class="container">
<h2>Login</h2>
<input id="user" placeholder="Username">
<input id="pass" type="password" placeholder="Password">
<button onclick="login()">Login</button>
<hr>
<h2>Add Expense</h2>
<select id="category">
<option>Food</option>
<option>Transport</option>
<option>Shopping</option>
<option>Bills</option>
</select>
<input id="amount" placeholder="Amount">
<input id="date" type="date">
<button onclick="addExpense()">Add</button>
<hr>
<h2>Expense Dashboard</h2>
<button onclick="loadExpenses()">Load Expenses</button>
<table id="table">
<tr>
<th>Category</th>
<th>Amount</th>
<th>Date</th>
</tr>
</table>
</div>
<script>
function login(){
fetch("/login",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
username:document.getElementById("user").value,
password:document.getElementById("pass").value
})
})
.then(res=>res.text())
.then(alert)
}
function addExpense(){
fetch("/addExpense",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
category:document.getElementById("category").value,
amount:document.getElementById("amount").value,
date:document.getElementById("date").value
})
})
.then(res=>res.text())
.then(alert)
}
function loadExpenses(){
fetch("/expenses")
.then(res=>res.json())
.then(data=>{
let table=document.getElementById("table")
table.innerHTML="<tr><th>Category</th><th>Amount</th><th>Date</th></tr>"
data.forEach(e=>{
table.innerHTML+=
"<tr><td>"+e.category+"</td><td>"+e.amount+"</td><td>"+e.date+"</td></tr>"
})
})
}
</script>
</body>
</html>
`);
});
app.post("/login", (req, res) => {
  const { username, password } = req.body;
  db.get(
    "SELECT * FROM users WHERE username=? AND password=?",
    [username, password],
    (err, row) => {
      if (row) res.send("Login Successful");
      else res.send("Invalid Login");
    }
  );
});
app.post("/addExpense", (req, res) => {
  const { category, amount, date } = req.body;
  db.run(
    "INSERT INTO expenses(category,amount,date) VALUES(?,?,?)",
    [category, amount, date],
    () => res.send("Expense Added")
  );
});
app.get("/expenses", (req, res) => {
  db.all("SELECT * FROM expenses", (err, rows) => {
    res.json(rows);
  });
});
app.listen(3000, () =>
  console.log("TrackWise running on http://localhost:3000")
);
